#!/usr/bin/env bash
#
# pg_sta_ctl -- command line interface for the pg_sta SQL Tuning Advisor.
#
# pg_sta is an open-source PostgreSQL 17 SQL Tuning Advisor: it analyses the
# workload, the execution plans and the table statistics of a database and
# returns explainable, ranked tuning recommendations with the evidence that
# produced them.
#
# Connection
# ----------
# Three modes are supported:
#
#   --local   use the local psql client and the standard PG* environment
#             variables (PGHOST, PGPORT, PGUSER, PGDATABASE, PGPASSWORD)
#   --ssh     run psql as the postgres user on the development VM over SSH,
#             using PG_STA_HOST / PG_STA_SSH_PORT / PG_STA_SSH_KEY
#   default   "auto": the SSH hop is used when it is usable and the local
#             psql client is used otherwise.  The scripts therefore work
#             unchanged both on the workstation and on the VM itself.
#
# Usage
# -----
#   pg_sta_ctl [--database DB] [--output text|markdown|json] <command> [args]
#
# Commands
# --------
#   collect                  capture a workload snapshot (sta.collect)
#   reset                    discard the collected snapshots (sta.reset)
#   report [--sql SQL]       all findings, ranked by impact
#   workload                 findings about the captured workload
#   plan SQL                 findings about the plan of one statement
#   stats [SCHEMA]           findings about the statistics of the tables
#   index SQL                index candidates for one statement
#   rewrite SQL              SQL rewrite candidates for one statement
#   actions [SQL]            the action plan: DDL, VACUUM/ANALYZE and rewrites
#   script [SQL]             the action plan as a runnable SQL script, with
#                            the plan before and after every step
#   before-after SQL [CHANGE]
#                            the plan before and after a change, and the
#                            benefit of the change (the change is rolled back)
#   before-after-report [SQL]
#                            the plan before and after the change for every
#                            statement of the workload, with the benefit of
#                            every change
#   tuning-report SQL [--out DIR] [--iterations N] [--time-limit N]
#                            the tuning report of one statement, written the
#                            way the Oracle SQL Tuning Advisor writes its
#                            report: the main report and the three files
#                            with the index finding, the alternative plans
#                            and the recommended change
#   plan-explanation SQL      the plan of a statement, written out in words
#   validate DDL SQL         measure a proposed index against the current plan
#   queryid SQL              the canonical query id of a statement
#   sqlid SQL                every identifier of a statement, the Oracle way
#   explain SQL              the execution plan of a statement
#   plan-advice SQL          PostgreSQL 19 style plan advice for one statement
#   advice ADVICE SQL        plan one statement with an advice string applied
#   stash list               list the advice stashes
#   stash create NAME        create an advice stash
#   stash drop NAME          drop an advice stash
#   stash show [NAME]        show the contents of an advice stash
#   stash set NAME QID ADVICE
#                            store advice for a query id in a stash
#   stash remove NAME QID    remove the advice stored for a query id
#   catalog                  the catalogue of all findings the advisor knows
#   server-info              version and configuration of the server
#   record SCOPE [TARGET]    record an advisory run in the audit trail
#   diff [SCHEMA]            compare the two most recent snapshots of a schema
#   load-sample-data         create the sample tables and generate a workload
#   install                  build and install the extension on the VM
#   upgrade                  apply the newest extension version in place
#                            (ALTER EXTENSION pg_sta UPDATE, keeps the
#                             collected workload and the audit trail)
#   regress                  run the regression suite
#   qa                       run the QA suite
#
# Examples
# --------
#   pg_sta_ctl --database appdb collect
#   pg_sta_ctl --database appdb report
#   pg_sta_ctl --database appdb --output json report > findings.json
#   pg_sta_ctl --database appdb plan "SELECT * FROM orders WHERE customer_id = 42"
#   pg_sta_ctl --database appdb index "SELECT * FROM orders WHERE customer_id = 42"
#   pg_sta_ctl --database appdb actions "SELECT * FROM orders WHERE customer_id = 42"
#   pg_sta_ctl --database appdb script "SELECT * FROM orders WHERE customer_id = 42" > fix.sql
#   pg_sta_ctl --database appdb script --no-plans > fix.sql
#   pg_sta_ctl --database appdb --statements 5 before-after-report
#   pg_sta_ctl --database appdb tuning-report \
#       "SELECT * FROM orders WHERE customer_id = 42" --out ./sta-report
#   pg_sta_ctl --database appdb before-after \
#       "SELECT * FROM orders WHERE customer_id = 42" \
#       "CREATE INDEX idx_orders_customer ON orders (customer_id)"
#   pg_sta_ctl --database appdb sqlid "SELECT * FROM orders WHERE customer_id = 42"
#   pg_sta_ctl --database appdb validate \
#       "CREATE INDEX idx_orders_customer ON orders (customer_id)" \
#       "SELECT * FROM orders WHERE customer_id = 42"
#   pg_sta_ctl --database appdb plan-advice "SELECT * FROM orders WHERE customer_id = 42"
#   pg_sta_ctl --database appdb advice "SEQ_SCAN(orders)" "SELECT * FROM orders WHERE customer_id = 42"
#   pg_sta_ctl --database appdb stash create nightly
#   pg_sta_ctl --database appdb stash set nightly 1234567890 "SEQ_SCAN(orders)"
#   pg_sta_ctl --database appdb stash show nightly
#   pg_sta_ctl --database appdb load-sample-data --analyze-all
#
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)

# shellcheck source=scripts/pg_sta_conn.sh
. "$HERE/pg_sta_conn.sh"

DB="$PG_STA_PGDATABASE"
OUTPUT=text
LIMIT=50
STATEMENTS=10
WINDOW=window
ITERATIONS=3
TIME_LIMIT=60
ANALYZE=false
PLANS=true
SQL_ARG=""
DDL_ARG=""
CHANGE_ARG=""
SCHEMA_ARG=""
SCOPE_ARG=""
TARGET_ARG=""
ADVICE_ARG=""
STASH_CMD=""
STASH_NAME=""
OUT_DIR="."
QID_ARG=""
EXTRA_ARGS=()

die() { echo "pg_sta_ctl: $*" >&2; exit 1; }

usage() {
    # Print the header comment block, minus the leading "# " markers.
    awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
}

# --------------------------------------------------------------------------
# Options
# --------------------------------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        -d|--database) DB="$2"; shift 2 ;;
        --local)       PG_STA_MODE=local; shift ;;
        --ssh)         PG_STA_MODE=ssh; shift ;;
        -o|--output)   OUTPUT="$2"; shift 2 ;;
        --limit)       LIMIT="$2"; shift 2 ;;
        --statements)  STATEMENTS="$2"; shift 2 ;;
        --window)      WINDOW="$2"; shift 2 ;;
        --iterations)  ITERATIONS="$2"; shift 2 ;;
        --time-limit)  TIME_LIMIT="$2"; shift 2 ;;
        --out)         OUT_DIR="$2"; shift 2 ;;
        --analyze)     ANALYZE=true; shift ;;
        --plans)       PLANS=true; shift ;;
        --no-plans)    PLANS=false; shift ;;
        -h|--help)     usage; exit 0 ;;
        --)            shift; break ;;
        -*)            die "unknown option: $1" ;;
        *)             break ;;
    esac
done

[ $# -ge 1 ] || { usage; exit 1; }
COMMAND="$1"; shift

case "$COMMAND" in
    plan|index|rewrite|queryid|explain|plan-advice|plan-explanation)
        [ $# -ge 1 ] || die "$COMMAND needs a SQL statement"
        SQL_ARG="$1"; shift ;;
    advice)
        [ $# -ge 2 ] || die "advice needs an advice string and a SQL statement"
        ADVICE_ARG="$1"; SQL_ARG="$2"; shift 2 ;;
    validate)
        [ $# -ge 2 ] || die "validate needs an index DDL and a SQL statement"
        DDL_ARG="$1"; SQL_ARG="$2"; shift 2 ;;
    before-after)
        [ $# -ge 1 ] || die "before-after needs a SQL statement"
        SQL_ARG="$1"; shift
        # The change is optional: without it the statement is measured
        # twice, which shows how much of the difference is noise.
        if [ $# -ge 1 ]; then CHANGE_ARG="$1"; shift; fi ;;
    sqlid)
        [ $# -ge 1 ] || die "sqlid needs a SQL statement"
        SQL_ARG="$1"; shift ;;
    tuning-report)
        [ $# -ge 1 ] || die "tuning-report needs a SQL statement"
        SQL_ARG="$1"; shift
        # The options of the command may also follow the statement.
        while [ $# -gt 0 ]; do
            case "$1" in
                --out)         OUT_DIR="$2"; shift 2 ;;
                --iterations)  ITERATIONS="$2"; shift 2 ;;
                --time-limit)  TIME_LIMIT="$2"; shift 2 ;;
                *)             die "unknown option for tuning-report: $1" ;;
            esac
        done ;;
    stash)
        [ $# -ge 1 ] || die "stash needs a subcommand (list, create, drop, show, set, remove)"
        STASH_CMD="$1"; shift
        case "$STASH_CMD" in
            list) ;;
            create|drop)
                [ $# -ge 1 ] || die "stash $STASH_CMD needs a stash name"
                STASH_NAME="$1"; shift ;;
            show)
                if [ $# -ge 1 ]; then STASH_NAME="$1"; shift; fi ;;
            set)
                [ $# -ge 3 ] || die "stash set needs a stash name, a query id and an advice string"
                STASH_NAME="$1"; QID_ARG="$2"; ADVICE_ARG="$3"; shift 3 ;;
            remove)
                [ $# -ge 2 ] || die "stash remove needs a stash name and a query id"
                STASH_NAME="$1"; QID_ARG="$2"; shift 2 ;;
            *) die "unknown stash subcommand: $STASH_CMD" ;;
        esac ;;
    stats|diff)
        if [ $# -ge 1 ]; then SCHEMA_ARG="$1"; shift; fi ;;
    report)
        if [ $# -ge 1 ]; then
            [ "$1" = "--sql" ] && shift
            SQL_ARG="$1"; shift
        fi ;;
    record)
        if [ $# -ge 1 ]; then SCOPE_ARG="$1"; shift; fi
        if [ $# -ge 1 ]; then TARGET_ARG="$1"; shift; fi ;;
    actions|script|before-after-report)
        # The statement is optional: without it the action plan is built
        # from the statements of the workload.  The options may also
        # follow the command, so they are read here as well.  Only the
        # options that are known are read as options, so a statement that
        # starts with a dash is still taken as a statement.
        while [ $# -gt 0 ]; do
            case "$1" in
                --limit)       LIMIT="$2"; shift 2 ;;
                --statements)  STATEMENTS="$2"; shift 2 ;;
                --window)      WINDOW="$2"; shift 2 ;;
                --iterations)  ITERATIONS="$2"; shift 2 ;;
                --analyze)     ANALYZE=true; shift ;;
                --plans)       PLANS=true; shift ;;
                --no-plans)    PLANS=false; shift ;;
                -o|--output)   OUTPUT="$2"; shift 2 ;;
                *)             break ;;
            esac
        done
        if [ $# -ge 1 ]; then SQL_ARG="$1"; shift; fi ;;
    collect|reset|workload|catalog|server-info|install|regress|qa|upgrade) ;;
    load-sample-data)
        # The remaining arguments belong to the loader.
        EXTRA_ARGS=("$@")
        ;;
    *) die "unknown command: $COMMAND" ;;
esac

case "$OUTPUT" in
    text|markdown|json) ;;
    *) die "unknown output format: $OUTPUT (use text, markdown or json)" ;;
esac

# --------------------------------------------------------------------------
# SQL helpers
# --------------------------------------------------------------------------

# Wrap a user supplied string as a dollar quoted SQL literal.  The tag is
# derived from the content and extended until it cannot occur in the string,
# so any SQL statement -- including one that contains dollar quotes itself --
# can be embedded safely.
sql_literal() {
    local s=$1 tag
    tag="\$pg_sta_$(printf '%s' "$s" | cksum | cut -d' ' -f1)\$"
    while [ "${s#*"$tag"}" != "$s" ]; do tag="${tag}_x"; done
    printf '%s%s%s' "$tag" "$s" "$tag"
}

# Run the SQL read from stdin and return the result on stdout.
#   $1 = extra psql flags (space separated)
run_sql() {
    local flags="$1"
    local tmp
    tmp=$(mktemp)
    cat > "$tmp"

    pg_sta_psql "$DB" "$flags" < "$tmp"
    local rc=$?
    rm -f "$tmp"
    return $rc
}

# Make sure the target database exists and carries the pg_sta extension.
# Without this check the commands fail with the rather cryptic
# "relation sta.recommendations does not exist".
require_extension() {
    local out
    out=$(printf '%s\n' "SELECT count(*) FROM pg_extension WHERE extname = 'pg_sta';" \
          | pg_sta_psql "$DB" "-q -A -t" 2>&1) || {
        echo "$out" >&2
        die "cannot connect to database '$DB' (mode: $PG_STA_MODE)"
    }
    if [ "$(printf '%s' "$out" | tr -d '[:space:]')" != "1" ]; then
        {
            echo "pg_sta_ctl: the pg_sta extension is not installed in database '$DB'."
            echo "             Install it with:"
            echo "               sudo -u postgres psql -d '$DB' -c 'CREATE EXTENSION pg_sta;'"
        } >&2
        exit 1
    fi
}

# The common projection of the three advice functions.  Every list oriented
# command is rendered from this shape, so the text, markdown and json output
# always describe the same fields.
project_advice() {
    # $1 = the SQL expression that produces the "subject" of the finding
    #      (the relation for plan/statistics findings, the statement text
    #       for workload findings).
    cat <<SQL
SELECT finding_id::int                        AS id,
       severity,
       category,
       $1                                      AS subject,
       finding,
       finding_text                           AS detail,
       recommendation,
       expected_benefit                       AS benefit,
       estimated_cost                         AS cost,
       validation_steps                       AS steps,
       confidence
SQL
}

# advice_text <base query>
#
# Renders the findings of the base query as an indented, human readable
# block.  This is the format a DBA reads: every finding states what was
# observed, what to do, what it should buy, what it costs and how to check
# it.
advice_text() {
    local base="$1"
    cat <<SQL
WITH r AS (
$base
), s AS (
    SELECT *, array_to_string(steps, E'\n              ') AS steps_text
    FROM r
)
SELECT 'pg_sta: ' || count(*) || ' finding(s)' || E'\n\n' ||
       coalesce(string_agg(
           '[' || severity || '] ' || category || ' / ' || finding ||
           CASE WHEN confidence IS NOT NULL AND confidence <> ''
                THEN '  (confidence: ' || confidence || ')' ELSE '' END ||
           E'\n' ||
           '  subject:   ' || coalesce(nullif(subject, ''), '-') || E'\n' ||
           '  observed:  ' || coalesce(nullif(detail, ''), '-') || E'\n' ||
           '  advice:    ' || coalesce(nullif(recommendation, ''), '-') || E'\n' ||
           '  benefit:   ' || coalesce(nullif(benefit, ''), '-') || E'\n' ||
           '  cost:      ' || coalesce(nullif(cost, ''), '-') || E'\n' ||
           '  validate:  ' || coalesce(nullif(steps_text, ''), '-'),
           E'\n\n' ORDER BY id), '')
FROM s;
SQL
}

# advice_markdown <base query>
advice_markdown() {
    local base="$1"
    cat <<SQL
WITH r AS (
$base
), s AS (
    SELECT *, coalesce(array_to_string(steps, ' / '), '-') AS steps_text
    FROM r
)
SELECT coalesce(
    '| # | Severity | Category | Subject | Finding | Advice | Expected benefit | Estimated cost | Validation steps |' || E'\n' ||
    '|---|---|---|---|---|---|---|---|---|' || E'\n' ||
    string_agg(
        '| ' || id || ' | ' || severity || ' | ' || category || ' | ' ||
        replace(coalesce(nullif(subject, ''), '-'), '|', '/') || ' | ' ||
        replace(finding, '|', '/') || ' | ' ||
        replace(coalesce(nullif(recommendation, ''), '-'), '|', '/') || ' | ' ||
        replace(coalesce(nullif(benefit, ''), '-'), '|', '/') || ' | ' ||
        replace(coalesce(nullif(cost, ''), '-'), '|', '/') || ' | ' ||
        replace(steps_text, '|', '/') || ' |',
        E'\n' ORDER BY id),
    'No findings.')
FROM s;
SQL
}

# advice_json <base query>
advice_json() {
    local base="$1"
    cat <<SQL
SELECT jsonb_pretty(coalesce(jsonb_agg(to_jsonb(r)), '[]'::jsonb))
FROM (
$base
) r;
SQL
}

# render_advice <base query>
#
# Dispatches on the requested output format.
render_advice() {
    local base="$1"
    case "$OUTPUT" in
        text)     advice_text "$base"     | run_sql "-q -A -t" ;;
        markdown) advice_markdown "$base" | run_sql "-q -A -t" ;;
        json)     advice_json "$base"     | run_sql "-q -A -t" ;;
    esac
}

# --------------------------------------------------------------------------
# Transport
# --------------------------------------------------------------------------
# Resolve "auto" into "ssh" or "local" once, so that every command uses the
# same transport and the user is told which one was chosen.
pg_sta_resolve_mode

# The build and test commands create the extension themselves; the loader
# creates it as well.  Every other command reads it from the target
# database, so it has to be there already.
case "$COMMAND" in
    install|regress|qa|load-sample-data) ;;
    *) require_extension ;;
esac

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
case "$COMMAND" in

collect)
    cat <<SQL | run_sql "-q"
SELECT 'collected' AS action,
       sample_id,
       captured_at,
       statements,
       tables
FROM sta.collect()
ORDER BY captured_at DESC
LIMIT 1;
SQL
    ;;

reset)
    echo "SELECT * FROM sta.reset();" | run_sql "-q"
    ;;

report)
    if [ -n "$SQL_ARG" ]; then
        lit=$(sql_literal "$SQL_ARG")
    else
        lit="NULL"
    fi
    base="SELECT finding_id::int AS id,
       severity,
       category,
       coalesce(object_name, left(coalesce(query, ''), 70)) AS subject,
       finding,
       finding_text AS detail,
       recommendation,
       expected_benefit AS benefit,
       estimated_cost AS cost,
       validation_steps AS steps,
       confidence
FROM sta.recommendations($lit, '$WINDOW', $ANALYZE, $LIMIT)"
    render_advice "$base"
    ;;

workload)
    base="$(project_advice "left(coalesce(query, ''), 70)")
FROM sta.workload_advice('$WINDOW', 0, 0, $LIMIT)"
    render_advice "$base"
    ;;

plan)
    base="$(project_advice "coalesce(object_name, '-')")
FROM sta.plan_advice($(sql_literal "$SQL_ARG"), $ANALYZE, $LIMIT)"
    render_advice "$base"
    ;;

stats)
    if [ -n "$SCHEMA_ARG" ]; then
        sch="'$(printf '%s' "$SCHEMA_ARG" | sed "s/'/''/g")'"
    else
        sch="NULL"
    fi
    base="$(project_advice "coalesce(object_name, '-')")
FROM sta.stats_advice($sch, $LIMIT)"
    render_advice "$base"
    ;;

diff)
    if [ -n "$SCHEMA_ARG" ]; then
        sch="'$(printf '%s' "$SCHEMA_ARG" | sed "s/'/''/g")'"
    else
        sch="NULL"
    fi
    base="$(project_advice "coalesce(object_name, '-')")
FROM sta.snapshot_diff($sch, $LIMIT)"
    render_advice "$base"
    ;;

index)
    cat <<SQL | run_sql "-q -A -t"
WITH a AS (
    SELECT relation, columns, suggested_ddl, rationale,
           estimated_benefit, estimated_cost, confidence, validation_steps
    FROM sta.index_advice($(sql_literal "$SQL_ARG"))
)
SELECT 'pg_sta: ' || count(*) || ' index candidate(s)' || E'\n\n' ||
       coalesce(string_agg(
           '[INDEX] ' || relation || ' (' || coalesce(array_to_string(columns, ', '), '-') || ')' || E'\n' ||
           '  ddl:        ' || suggested_ddl || E'\n' ||
           '  observed:   ' || rationale || E'\n' ||
           '  benefit:    ' || coalesce(estimated_benefit, '-') || E'\n' ||
           '  cost:       ' || coalesce(estimated_cost, '-') || E'\n' ||
           '  confidence: ' || coalesce(confidence, '-') || E'\n' ||
           '  validate:   ' || coalesce(array_to_string(validation_steps, E'\n               '), '-'),
           E'\n\n'), '')
FROM a;
SQL
    ;;

rewrite)
    cat <<SQL | run_sql "-q -A -t"
WITH a AS (
    SELECT pattern, object_name, severity, confidence,
           original_sql, rewritten_sql, finding_text,
           recommendation, expected_benefit, estimated_cost, validation_steps
    FROM sta.rewrite_advice($(sql_literal "$SQL_ARG"))
)
SELECT 'pg_sta: ' || count(*) || ' rewrite candidate(s)' || E'\n\n' ||
       coalesce(string_agg(
           '[REWRITE] ' || coalesce(pattern, '-') || ' (' || coalesce(object_name, '-') || ')' || E'\n' ||
           '  original:    ' || coalesce(original_sql, '-') || E'\n' ||
           '  rewritten:   ' || coalesce(rewritten_sql, '-') || E'\n' ||
           '  observed:    ' || coalesce(finding_text, '-') || E'\n' ||
           '  benefit:     ' || coalesce(expected_benefit, '-') || E'\n' ||
           '  cost:        ' || coalesce(estimated_cost, '-') || E'\n' ||
           '  confidence:  ' || coalesce(confidence, '-') || E'\n' ||
           '  validate:    ' || coalesce(array_to_string(validation_steps, E'\n               '), '-'),
           E'\n\n'), '')
FROM a;
SQL
    ;;

actions)
    if [ -n "$SQL_ARG" ]; then
        lit=$(sql_literal "$SQL_ARG")
    else
        lit="NULL"
    fi
    cat <<SQL | run_sql "-q -A -t"
WITH a AS (
    SELECT action_id, action_type, priority, object_name, query,
           action_sql, finding, finding_text, severity, confidence,
           rationale, expected_benefit, estimated_cost, risk, validation_steps
    FROM sta.action_plan($lit, '$WINDOW', $ANALYZE, $LIMIT)
)
SELECT 'pg_sta: ' || count(*) || ' action(s)' || E'\n\n' ||
       coalesce(string_agg(
           '[' || action_type || '] ' || coalesce(object_name, '-') ||
           ' (priority ' || priority || ', ' || coalesce(severity, '-') || ')' || E'\n' ||
           '  sql:         ' || coalesce(action_sql, '-') || E'\n' ||
           '  finding:     ' || coalesce(finding, '-') || E'\n' ||
           '  observed:    ' || coalesce(finding_text, '-') || E'\n' ||
           '  benefit:     ' || coalesce(expected_benefit, '-') || E'\n' ||
           '  cost:        ' || coalesce(estimated_cost, '-') || E'\n' ||
           '  risk:        ' || coalesce(risk, '-') || E'\n' ||
           '  confidence:  ' || coalesce(confidence, '-') || E'\n' ||
           '  validate:    ' || coalesce(array_to_string(validation_steps, E'\n               '), '-'),
           E'\n\n'), '')
FROM a;
SQL
    ;;

script)
    # The runnable script is printed exactly as it is: it is meant to be
    # redirected to a file and executed with psql.
    if [ -n "$SQL_ARG" ]; then
        lit=$(sql_literal "$SQL_ARG")
    else
        lit="NULL"
    fi
    cat <<SQL | run_sql "-q -A -t"
SELECT sta.action_script($lit, '$WINDOW', $ANALYZE, $LIMIT, $PLANS, $ITERATIONS);
SQL
    ;;

tuning-report)
    # The Oracle style report.  The function returns the four files as one
    # text, separated by the markers ">>> FILE: <name>" and
    # "<<< END FILE: <name>"; they are written to the output directory
    # here, with the names the Oracle report uses.
    lit=$(sql_literal "$SQL_ARG")
    mkdir -p "$OUT_DIR"
    tmp=$(mktemp)
    if ! printf 'SELECT sta.tuning_report(%s, %s, %s);\n' "$lit" "$ITERATIONS" "$TIME_LIMIT" \
            | run_sql "-q -A -t" > "$tmp"; then
        rm -f "$tmp"
        die "the tuning report failed"
    fi
    # Every file is written under the name of its marker; the list of the
    # files is printed on stdout, one file per line.
    awk -v dir="$OUT_DIR" '
        /^>>> FILE: /     { name = dir "/" substr($0, 11); next }
        /^<<< END FILE: / {
            if (name != "") { close(name); print name; name = "" }
            next
        }
        name != ""         { print > name }
    ' "$tmp" | while read -r f; do
        printf 'wrote %s\n' "$f"
    done
    rm -f "$tmp"
    ;;

before-after-report)
    # The plan before and after the change for every statement of the
    # workload, with the benefit of the change.  Every change is rolled
    # back: nothing is left behind in the database.
    if [ -n "$SQL_ARG" ]; then
        lit=$(sql_literal "$SQL_ARG")
    else
        lit="NULL"
    fi
    cat <<SQL | run_sql "-q -A -t"
SELECT 'pg_sta: the plan before and after the change, for every statement' || E'\n' ||
       'database: ' || current_database() || E'\n' ||
       'window:   ' || '$WINDOW' || E'\n\n' ||
       coalesce(string_agg(
           E'\n--- ' || r.report_id || '. ' ||
              coalesce(nullif(r.relation, ''), r.change_type) || ' ---' || E'\n' ||
           'statement:    ' || r.statement || E'\n' ||
           'change type:  ' || r.change_type || E'\n' ||
           'change:       ' || coalesce(r.change_sql, '(none)') || E'\n' ||
           'measured:     ' || r.measurement || E'\n' ||
           E'\n--- PLAN BEFORE --------------------------------------------\n' ||
           coalesce(r.before_plan, '(no plan)') || E'\n' ||
           E'--- PLAN AFTER ---------------------------------------------\n' ||
           coalesce(r.after_plan, '(no plan)') || E'\n' ||
           E'--- reading of the plan before ------------------------------\n' ||
           coalesce(r.before_reading, '(none)') || E'\n' ||
           E'--- reading of the plan after -------------------------------\n' ||
           coalesce(r.after_reading, '(none)') || E'\n' ||
           E'--- benefit -----------------------------------------------\n' ||
           'before:       ' || coalesce(round(r.before_ms::numeric, 3)::text, '-') || ' ms' || E'\n' ||
           'after:        ' || coalesce(round(r.after_ms::numeric, 3)::text, '-') || ' ms' || E'\n' ||
           'cost:         ' || coalesce(round(r.before_cost::numeric, 1)::text, '-') || ' -> ' ||
                            coalesce(round(r.after_cost::numeric, 1)::text, '-') || E'\n' ||
           'gain:         ' || coalesce(round(r.improvement_pct::numeric, 1)::text, '-') || ' %' ||
                            CASE WHEN r.benefit_basis IS NOT NULL
                                 THEN ' (' || r.benefit_basis || ')' ELSE '' END || E'\n' ||
           'buffers:      ' || coalesce(r.before_buffers::text, '-') || ' -> ' ||
                            coalesce(r.after_buffers::text, '-') ||
                            CASE WHEN r.buffer_change_pct IS NOT NULL
                                 THEN ' (' || round(r.buffer_change_pct::numeric, 1)::text || ' %)' ELSE '' END ||
                            E'\n' ||
           'buffer split: ' || coalesce(r.before_hit::text, '-') || ' hit / ' ||
                            coalesce(r.before_read::text, '-') || ' read  ->  ' ||
                            coalesce(r.after_hit::text, '-') || ' hit / ' ||
                            coalesce(r.after_read::text, '-') || ' read' || E'\n' ||
           'rows:         ' || coalesce(r.before_rows::text, '-') || ' -> ' ||
                            coalesce(r.after_rows::text, '-') ||
                            CASE WHEN r.rows_identical IS NOT NULL
                                 THEN ' (identical: ' || r.rows_identical::text ||
                                      ', order preserved: ' ||
                                      coalesce(r.order_preserved::text, 'not checked') || ')'
                                 WHEN r.rows_match IS NOT NULL
                                 THEN ' (same number of rows: ' || r.rows_match::text || ')'
                                 ELSE '' END || E'\n' ||
           'row by row:   ' ||
                            CASE WHEN r.comparison IS NOT NULL
                                 THEN coalesce(r.comparison::text, '(not compared)')
                                 ELSE '(the change does not change the rows)' END || E'\n' ||
           'assumptions:  ' || coalesce(nullif(r.assumptions::text, '[]'), '(none)') || E'\n' ||
           'plan changed: ' || coalesce(r.plan_changed::text, '-') || E'\n' ||
           'rows match:   ' || coalesce(r.rows_match::text, '-') || E'\n' ||
           'verdict:      ' || coalesce(r.verdict, '-') || E'\n' ||
           'plan changes:' || E'\n' ||
           coalesce(array_to_string(r.node_changes, E'\n'), '(none)') || E'\n' ||
           'notes:' || E'\n' ||
           coalesce(array_to_string(r.notes, E'\n'), '(none)'),
           E'\n'), '')
FROM sta.before_after_report($lit, '$WINDOW', $ITERATIONS, $STATEMENTS, true) r;
SQL
    ;;

before-after)
    # The plan of the statement before and after the change, the reading
    # of both plans and the benefit of the change.  The change is rolled
    # back: nothing is left behind.
    if [ -n "$CHANGE_ARG" ]; then
        chg=$(sql_literal "$CHANGE_ARG")
    else
        chg="NULL"
    fi
    cat <<SQL | run_sql "-q -A -t"
SELECT 'pg_sta: the plan before and after the change' || E'\n\n' ||
       'statement:  ' || coalesce(d.statement, '-') || E'\n' ||
       'change:     ' || coalesce(d.change_sql, '(none)') || E'\n' ||
       'change type: ' || coalesce(d.change_type, '-') || E'\n' ||
       E'\n' ||
       '--- BEFORE -----------------------------------------------------' || E'\n' ||
       coalesce(d.before_plan, '(no plan)') || E'\n' ||
       '--- AFTER ------------------------------------------------------' || E'\n' ||
       coalesce(d.after_plan, '(no plan)') || E'\n' ||
       '--- reading of the plan before ---------------------------------' || E'\n' ||
       coalesce(d.before_reading, '(none)') || E'\n' ||
       '--- reading of the plan after ----------------------------------' || E'\n' ||
       coalesce(d.after_reading, '(none)') || E'\n' ||
       '--- benefit ----------------------------------------------------' || E'\n' ||
       'before:      ' || coalesce(round(d.before_ms::numeric, 3)::text, '-') || ' ms' || E'\n' ||
       'after:       ' || coalesce(round(d.after_ms::numeric, 3)::text, '-') || ' ms' || E'\n' ||
       'improvement: ' || coalesce(round(d.improvement_pct::numeric, 2)::text, '-') || ' %' ||
           CASE WHEN d.benefit_basis IS NOT NULL
                THEN ' (' || d.benefit_basis || ')' ELSE '' END || E'\n' ||
       'buffers:     ' || coalesce(d.before_buffers::text, '-') || ' -> ' ||
           coalesce(d.after_buffers::text, '-') || ' total' || E'\n' ||
       'buffer split: ' || coalesce(d.before_hit::text, '-') || ' hit / ' ||
           coalesce(d.before_read::text, '-') || ' read  ->  ' ||
           coalesce(d.after_hit::text, '-') || ' hit / ' ||
           coalesce(d.after_read::text, '-') || ' read' || E'\n' ||
       'rows:        ' || coalesce(d.before_rows::text, '-') || ' -> ' ||
           coalesce(d.after_rows::text, '-') ||
           CASE WHEN d.rows_identical IS NOT NULL
                THEN ' (identical: ' || d.rows_identical::text ||
                     ', order preserved: ' ||
                     coalesce(d.order_preserved::text, 'not checked') || ')'
                WHEN d.rows_match IS NOT NULL
                THEN ' (same number of rows: ' || d.rows_match::text || ')'
                ELSE '' END || E'\n' ||
       'row by row:  ' ||
           CASE WHEN d.comparison IS NOT NULL
                THEN coalesce(d.comparison::text, '(not compared)')
                ELSE '(the change does not change the rows)' END || E'\n' ||
       'assumptions: ' || coalesce(nullif(d.assumptions::text, '[]'), '(none)') || E'\n' ||
       'plan changed: ' || coalesce(d.plan_changed::text, '-') || E'\n' ||
       'rows match:   ' || coalesce(d.rows_match::text, '-') || E'\n' ||
       'verdict:      ' || coalesce(d.verdict, '-') || E'\n' ||
       'plan changes:' || E'\n' ||
       coalesce(array_to_string(d.node_changes, E'\n'), '(none)') || E'\n' ||
       'notes:' || E'\n' ||
       coalesce(array_to_string(d.notes, E'\n'), '(none)')
FROM sta.before_after_detail($(sql_literal "$SQL_ARG"), $chg, 'AUTO', $ITERATIONS) d;
SQL
    ;;

plan-explanation)
    # The plan of the statement, written out in words: what it does, what
    # it costs and where the time goes.
    cat <<SQL | run_sql "-q -A -t"
SELECT coalesce(sta.statement_explanation($(sql_literal "$SQL_ARG"), $ANALYZE), '(no plan)');
SQL
    ;;

sqlid)
    cat <<SQL | run_sql "-q -A -t"
SELECT 'query id:     ' || queryid || E'\n' ||
       'sql id:       ' || sql_id || E'\n' ||
       'sql hash:     ' || sql_hash || E'\n' ||
       'normalized:   ' || coalesce(normalized_sql, '-') || E'\n' ||
       'recorded:     ' || coalesce(recorded_sql, '-') || E'\n' ||
       'in pg_stat_statements: ' || in_stat_statements::text || E'\n' ||
       'calls:        ' || calls || E'\n' ||
       'total time:   ' || round(total_exec_time::numeric, 3) || ' ms' || E'\n' ||
       'mean time:    ' || round(mean_exec_time::numeric, 3) || ' ms' || E'\n' ||
       'shared hit:   ' || shared_blks_hit || E'\n' ||
       'shared read:  ' || shared_blks_read
FROM sta.queryid_info($(sql_literal "$SQL_ARG"));
SQL
    ;;

validate)
    cat <<SQL | run_sql "-q -A -t"
SELECT 'verdict:        ' || verdict || E'\n' ||
       'baseline:       ' || round(baseline_ms::numeric, 3) || ' ms' || E'\n' ||
       'candidate:      ' || round(candidate_ms::numeric, 3) || ' ms' || E'\n' ||
       'improvement:    ' || round(improvement_pct::numeric, 2) || ' %' || E'\n' ||
       'plan changed:   ' || plan_changed::text || E'\n' ||
       'rows match:     ' || rows_match::text || E'\n' ||
       'notes:          ' || coalesce(array_to_string(notes, E'\n                '), '-')
FROM sta.validate($(sql_literal "$DDL_ARG"), $(sql_literal "$SQL_ARG"), $ITERATIONS);
SQL
    ;;

queryid)
    cat <<SQL | run_sql "-q -A -t"
SELECT 'queryid:         ' || sta.queryid($(sql_literal "$SQL_ARG")) || E'\n' ||
       'normalized text: ' || sta.queryid_normalized($(sql_literal "$SQL_ARG"))
SQL
    ;;

explain)
    cat <<SQL | run_sql "-q -A -t"
SELECT jsonb_pretty(sta.explain($(sql_literal "$SQL_ARG"), $ANALYZE));
SQL
    ;;

plan-advice)
    cat <<SQL | run_sql "-q -A -t"
SELECT 'advice:        ' || coalesce(sta.plan_advice_string($(sql_literal "$SQL_ARG"), $ANALYZE), '(none)') || E'\n' ||
       'advice items:  ' || coalesce(array_to_string(sta._advice_split(sta.plan_advice_string($(sql_literal "$SQL_ARG"), $ANALYZE)), ', '), '(none)') || E'\n' ||
       'query id:      ' || sta.queryid($(sql_literal "$SQL_ARG"))
SQL
    ;;

advice)
    cat <<SQL | run_sql "-q -A -t"
SELECT 'advice:       ' || $(sql_literal "$ADVICE_ARG") || E'\n' ||
       'applied:      ' || coalesce(array_to_string(e.applied, ', '), '(none)') || E'\n' ||
       'restored:     ' || coalesce(array_to_string(e.restored, ', '), '(none)') || E'\n' ||
       'top node:     ' || coalesce(e.plan->0->'Plan'->>'Node Type', '-') || E'\n' ||
       'plan:         ' || jsonb_pretty(e.plan)
FROM sta.explain_with_advice($(sql_literal "$ADVICE_ARG"), $(sql_literal "$SQL_ARG"), $ANALYZE) e;
SQL
    ;;

stash)
    case "$STASH_CMD" in
        list)
            cat <<SQL | run_sql "-q"
SELECT stash_name, num_entries FROM sta.get_stashes() ORDER BY stash_name;
SQL
            ;;
        create)
            cat <<SQL | run_sql "-q -A -t"
DO \$pg_sta_do\$ BEGIN PERFORM sta.create_stash($(sql_literal "$STASH_NAME")); END \$pg_sta_do\$;
SELECT 'created stash ' || $(sql_literal "$STASH_NAME") || E'\n' ||
       'stashes now: ' || coalesce((SELECT string_agg(s.stash_name, ', ' ORDER BY s.stash_name) FROM sta.get_stashes() s), '(none)');
SQL
            ;;
        drop)
            cat <<SQL | run_sql "-q -A -t"
DO \$pg_sta_do\$ BEGIN PERFORM sta.drop_stash($(sql_literal "$STASH_NAME")); END \$pg_sta_do\$;
SELECT 'dropped stash ' || $(sql_literal "$STASH_NAME") || E'\n' ||
       'stashes now: ' || coalesce((SELECT string_agg(s.stash_name, ', ' ORDER BY s.stash_name) FROM sta.get_stashes() s), '(none)');
SQL
            ;;
        show)
            cat <<SQL | run_sql "-q"
SELECT stash_name, query_id, advice_string FROM sta.get_stash_contents($(sql_literal "$STASH_NAME")) ORDER BY stash_name, query_id;
SQL
            ;;
        set)
            cat <<SQL | run_sql "-q -A -t"
DO \$pg_sta_do\$ BEGIN PERFORM sta.set_stashed_advice($(sql_literal "$STASH_NAME"), $QID_ARG::bigint, $(sql_literal "$ADVICE_ARG")); END \$pg_sta_do\$;
SELECT 'stored advice for query id ' || $QID_ARG || ' in stash ' || $(sql_literal "$STASH_NAME") || E'\n' ||
       'entries now: ' || (SELECT s.num_entries FROM sta.get_stashes() s WHERE s.stash_name = $(sql_literal "$STASH_NAME"));
SQL
            ;;
        remove)
            cat <<SQL | run_sql "-q -A -t"
DO \$pg_sta_do\$ BEGIN PERFORM sta.set_stashed_advice($(sql_literal "$STASH_NAME"), $QID_ARG::bigint, NULL); END \$pg_sta_do\$;
SELECT 'removed advice for query id ' || $QID_ARG || ' from stash ' || $(sql_literal "$STASH_NAME") || E'\n' ||
       'entries now: ' || (SELECT s.num_entries FROM sta.get_stashes() s WHERE s.stash_name = $(sql_literal "$STASH_NAME"));
SQL
            ;;
    esac
    ;;

catalog)
    cat <<SQL | run_sql "-q"
SELECT category, finding, default_severity AS severity, description,
       evidence_source, recommended_action, validation_kind
FROM sta.advice_catalog()
ORDER BY category, finding;
SQL
    ;;

server-info)
    echo "SELECT jsonb_pretty(sta.server_info());" | run_sql "-q -A -t"
    ;;

record)
    if [ -z "$SCOPE_ARG" ]; then die "record needs a scope (for example: report, workload, plan)"; fi
    cat <<SQL | run_sql "-q -A -t"
SELECT 'recorded run ' || sta.record_run(
    $(sql_literal "$SCOPE_ARG"),
    $(sql_literal "$TARGET_ARG"),
    $LIMIT,
    $(sql_literal "recorded by pg_sta_ctl"));
SQL
    ;;

install)
    "$HERE/install.sh"
    ;;
upgrade)
    # Apply the newest extension version to the target database without
    # dropping the collected workload: ALTER EXTENSION ... UPDATE keeps
    # every object, so the history in sta.* survives the upgrade.
    require_extension
    echo "pg_sta_ctl: upgrading the pg_sta extension in database '$DB'..."
    printf '%s\n' \
        "ALTER EXTENSION pg_sta UPDATE;" \
        "SELECT extversion FROM pg_extension WHERE extname = 'pg_sta';" \
        | pg_sta_psql "$DB" "-q -A -t" || die "ALTER EXTENSION pg_sta UPDATE failed"
    echo "pg_sta_ctl: done."
    ;;

load-sample-data)
    "$HERE/load_sample_data.sh" --database "$DB" \
        ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}
    ;;

regress)
    "$HERE/installcheck.sh"
    ;;

qa)
    "$ROOT/test/run_qa.sh"
    ;;
esac