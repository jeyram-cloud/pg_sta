-- 6. Index advice
------------------------------------------------------------------------------
SELECT count(*) > 0 AS index_advice_proposes_candidate
FROM sta.index_advice('SELECT * FROM sta_regress.orders WHERE customer_id = 7 AND status = ''new''');
 index_advice_proposes_candidate 
---------------------------------
